    {
      "name": "4. Orders (Checkout & Lifecycle)",
      "description": "Concurrency-safe checkout with atomic inventory decrement, client idempotency keys, and order cancellation.",
      "item": [
        {
          "name": "4.1 Place Order (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 201 && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('order_id', res.data.id);",
                  "    console.log('✓ Successfully created order! order_id: ' + res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-idempotency-key",
                "value": "idem-key-{{$timestamp}}",
                "description": "Protects against double-orders upon slow network retries"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"fulfillmentType\": \"delivery\",\n  \"paymentMethod\": \"cod\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            },
            "description": "Places order inside a PostgreSQL transaction. Atomically decrements product stock and records GST invoice sequence."
          },
          "response": []
        },
        {
          "name": "4.2 List Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "placed",
                  "disabled": true
                }
              ]
            },
            "description": "Returns paginated list of orders placed by the current customer."
          },
          "response": []
