# Environment Configuration for Bhagwati Kisan Mart Backend

NODE_ENV=development
PORT=4000

# Supabase Postgres Connection
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Upstash Redis Connection (for sessions & rate-limiting)
REDIS_URL=redis://default:your-redis-password@your-upstash-endpoint.upstash.io:6379

# JWT Secrets (HMAC min 16 characters)
JWT_SECRET=bhagwati_kisan_mart_jwt_super_secret_key_change_me_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=bhagwati_kisan_mart_refresh_token_super_secret_key_67890
JWT_REFRESH_EXPIRES_IN=7d

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_dlt_approved_template_id
